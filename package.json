{
  "name": "pasovivo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @pasovivo/web dev",
    "dev:api": "pnpm --filter @pasovivo/api dev",
    "build": "turbo run build",
    "start": "pnpm --filter @pasovivo/web start",
    "start:api": "pnpm --filter @pasovivo/api start",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:verification": "vitest run --config tests/verification/vitest.config.ts && playwright test --config playwright.verification.config.ts",
    "typecheck:verification": "tsc -p tsconfig.verification.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "db:migrate": "pnpm --filter @pasovivo/database db:migrate",
    "db:deploy": "pnpm --filter @pasovivo/database db:deploy",
    "db:seed": "pnpm --filter @pasovivo/database db:seed",
    "db:status": "pnpm --filter @pasovivo/database db:status",
    "db:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/compose/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
