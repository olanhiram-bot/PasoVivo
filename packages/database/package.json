{
  "name": "@pasovivo/database",
  "version": "0.1.0",
  "private": true,
  "description": "Esquema Prisma, migraciones y cliente de PostgreSQL de PasoVivo.",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:status": "dotenv -e ../../.env -- prisma migrate status",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pasovivo/security": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
