# PasoVivo · variables de ejemplo
# Copiar a .env y ajustar en local: `cp .env.example .env`.
# Nunca commitear secretos reales ni reutilizar estos valores fuera de desarrollo.

# --- Aplicación -----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
WEB_BASE_URL=http://127.0.0.1:3000

# --- API ------------------------------------------------------------------------
API_PORT=3001
API_BASE_URL=http://127.0.0.1:3001
# Orígenes permitidos por CORS, separados por coma. Vacío = ninguno.
API_CORS_ORIGINS=http://127.0.0.1:3000
# Tiempo máximo del dashboard al consultar el API (ms).
API_TIMEOUT_MS=5000

# --- Persistencia y colas (PV-008 / PV-010: todavía no conectadas) ---------------
DATABASE_URL=postgresql://pasovivo:pasovivo@127.0.0.1:5432/pasovivo?schema=public
REDIS_URL=redis://127.0.0.1:6379

# --- Sesiones, runner y artefactos ----------------------------------------------
# Valor de ejemplo: generar uno propio con `openssl rand -base64 32`.
SESSION_SECRET=cambiar-en-local-32-caracteres-minimo
RUNNER_CONCURRENCY=1
RUN_TIMEOUT_MS=120000
ARTIFACT_STORAGE_DRIVER=filesystem
ARTIFACT_STORAGE_PATH=./var/artifacts
ARTIFACT_RETENTION_DAYS=30

# --- IA opcional (desactivada por defecto) --------------------------------------
AI_ENABLED=false
AI_PROVIDER=
